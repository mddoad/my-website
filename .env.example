# Contact form email delivery (Resend)
#
# Set these in your host's dashboard (Vercel / Netlify / etc.)
# before deploy, or in a local .env.local (gitignored) for
# development. .env.local is already in .gitignore, so secrets
# never land in the repo.

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Destination address — where form submissions land.
# Usually a sales or info inbox.
CONTACT_EMAIL_TO=

# Verified sender. Resend requires you to verify a domain
# before you can send from it; the address must use that
# domain. See https://resend.com/domains.
# Example: "Meridian Manufacturing <no-reply@meridian-mfg.com>"
CONTACT_EMAIL_FROM=
